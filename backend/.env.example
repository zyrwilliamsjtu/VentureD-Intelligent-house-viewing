# Copy to .env locally. Do not put real keys here.
CORS_ORIGINS=http://localhost:5173
# AGENT_BASE_URL=http://127.0.0.1:8001
# 理解层 Provider：gt（默认，读 mock scene_graph）| dual_engine（未实现）
UNDERSTANDING_PROVIDER=gt

# ---- agent 真实 API（key 只写 .env，本文件留空）----
# Provider：stub（默认）| openai_compat（chat 方舟）| volcengine（豆包语音 TTS/ASR）
ASR_PROVIDER=stub
TTS_PROVIDER=stub
CHAT_PROVIDER=stub

# chat：火山方舟 OpenAI 兼容（base 已含 /api/v3，不要再拼 /v1）
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# 结构化路由（开放问题）用较快模型；留空则回落 LLM_MODEL
# 待确认：控制台 lite 接入点 ID，例如 doubao-1.5-lite-32k-250115 或 ep-...
AGENT_ROUTE_MODEL=

# openai_compat 语音（可选）
ASR_API_KEY=
ASR_BASE_URL=
ASR_MODEL=
TTS_API_KEY=
TTS_BASE_URL=
TTS_MODEL=

# 豆包语音 volcengine（值只写 .env）
ASR_APP_ID=
ASR_ACCESS_TOKEN=
ASR_SECRET_KEY=
ASR_RESOURCE_ID=
TTS_APP_ID=
TTS_ACCESS_TOKEN=
TTS_SECRET_KEY=
TTS_RESOURCE_ID=
TTS_VOICE=


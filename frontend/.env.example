# ==== 前端环境配置 ====
# mock = 本地模拟数据（无需后端）；real = 对接队友后端
VITE_API_MODE=mock
# 后端地址。留空 = 同源（dev 由 vite proxy /api 转发到 127.0.0.1:8000，无跨源问题，推荐）；
# 仅当后端在别的机器/端口时填绝对地址（如 http://192.168.x.x:8000，需后端开 CORS）
VITE_API_BASE=

# 群核 Aholo 开放平台（labs.aholo3d.cn 申请，复制本文件为 .env.local 并填入真实值）
# 注意：VITE_ 前缀变量会被打包进前端产物，公网可被查看；比赛期可接受，长期建议走后端代理
VITE_AHOLO_API_KEY=
VITE_AHOLO_GATEWAY=https://api.aholo3d.cn
# 漫游场景点云直链（SPZ/SOG/PLY，来自 World API assets.splats.urls；留空用官方示例场景）
VITE_AHOLO_SPLAT_URL=
# LOD 分块元数据（World API 返回的 lodMetaPath）
VITE_AHOLO_LOD_META_URL=
# 体素碰撞元数据（splat-transform Voxel 产物；默认取本地 public/collision/voxel-meta.json）
VITE_AHOLO_VOXEL_META_URL=
# 业务世界 ID（PI 决策 2 · 2026-08-28）：demo 统一 0330 真实场景 w_0330_840483，
# 与后端 GT/mock/camera_poses 一致；前端代码缺省同样回退 w_0330_840483。
# 未登记世界前端恒等降级（room_id=null，坐标不映射）
VITE_WORLD_ID=w_0330_840483
